  "limitations": [
    {
      "id": "EXPLICIT_ABSOLUTE_MCG_MIN_ONLY",
      "text": "Only explicit absolute norepinephrine rates in mcg/min are represented. A relative instruction (for example, \"increase norepinephrine\") while no infusion is running is not supported."
    },
    {
      "id": "NO_WEIGHT_BASED_DOSING",
      "text": "Weight-based doses (mcg/kg/min) are not represented and are never converted."
    },
    {
      "id": "NO_MAP_TARGET_TITRATION",
      "text": "Titration to a pressure target (for example, \"titrate to MAP 65\") is not represented: no rate is ever chosen from a pressure."
    },
    {
      "id": "MALFORMED_ORDER_CLOSES_THE_MODELLED_INFUSION",
      "text": "An order the system cannot read as an explicit absolute rate (an unsupported or malformed order) ends the modelled infusion for the rest of the encounter. It is declared, and nothing later in that encounter recovers it."
    },
    {
      "id": "CONSCIOUSNESS_UNDER_TONE_UNRESOLVED",
      "text": "Consciousness under vascular-tone support was neither shown nor judged in this review. It remains unresolved."
    },
    {
      "id": "COMMON_TONE_PUMP_DEPENDENCE_NOT_YET_VALIDATED",
      "text": "How strongly the pressure response depends on the state of the pump is not yet validated. This review used a hemorrhage case and does not support the use of a vasopressor in pump-limited conditions."
    }
  ],
